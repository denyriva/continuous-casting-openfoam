flowchart TD

    A["Begin physical OpenFOAM step n -> n+1<br/>Known accepted state at tn:<br/>U, p, phi, T, Carbon, fs, phase fields, turbulence"]

    A --> B["preSolve()<br/>Advance Voller-Beckermann localSolidificationTime<br/>from previous accepted phase state<br/>Update Courant/LTS information<br/>Update mesh if required"]

    B --> C["Momentum-transport predictor<br/>momentumTransport->predict()"]

    C --> D["Update buoyancy<br/>thermal + solutal Boussinesq acceleration"]

    D --> E["Update moving-solid BKC drag<br/>D = nu_l / K(fs)<br/>drag acts on U - Us"]

    E --> F["Solve momentum predictor<br/>ddt(U) + div(phi,U) + viscous + Sp(D,U)<br/>= -grad(p) + fvModels + D Us + buoyancy"]

    F --> G["Enter thermophysicalPredictor()<br/>Physical dt = OpenFOAM deltaT"]

    G --> H["Checkpoint thermophysical fields at physical-step start<br/>T, Carbon, fs, CarbonL, CarbonS,<br/>interface/back-diffusion fields, CpMix, kEff,<br/>species coefficients, macrosegregation diagnostics"]

    H --> I["Set Nsub = 1<br/>dtThermo = dtPhysical / Nsub"]

    I --> J["Create local thermophysical old-state fields<br/>TsubOld, CsubOld, fssubOld, CpMixSubOld"]

    J --> K["Start thermophysical substep j = 1 ... Nsub<br/>Reset nonlinear relaxation factors<br/>omegaT, omegaC, omegaFs"]

    K --> L["Start nonlinear Picard correction k"]

    L --> M["Store iteration state<br/>T(k), C(k), fs(k)"]

    M --> N["Freeze current phase-dependent energy coefficients<br/>CpMix(fs), kEff(fs), latent linearisation,<br/>fully-liquid turbulent thermal switch"]

    N --> O["Solve energy equation over dtThermo<br/>local transient history uses TsubOld/CpMixSubOld<br/>Implicit T + latent linearisation<br/>Apply omegaT nonlinear relaxation"]

    O --> P["Update phase + microsegregation closure after T solve<br/>Tliq/Tsol, fs, CarbonL, CarbonS,<br/>VB/Lever closure, CpMix, kEff, dfsdT, CpApp<br/>Apply omegaFs"]

    P --> Q["Update species coefficients<br/>DL_eff = DL + nut/Sct<br/>phase fractions/compositions frozen for this correction"]

    Q --> R["Solve mixture Carbon equation over dtThermo<br/>local transient history uses CsubOld<br/>bulk advection with U<br/>relative phase advection with U - Us<br/>selected diffusion linearisation<br/>Apply omegaC"]

    R --> S["Re-close phase + microsegregation after Carbon solve<br/>Carbon changes equilibrium -> fs, Cl, Cs, properties<br/>Apply omegaFs"]

    S --> T["Compute nonlinear changes<br/>dT  = max |T(k+1)-T(k)|<br/>dC  = max |C(k+1)-C(k)|<br/>dfs = max |fs(k+1)-fs(k)|"]

    T --> U["Normalized coupling residual<br/>R = max(dT/Ttol, dC/Ctol, dfs/fstol)"]

    U --> V{"Adaptive relaxation enabled<br/>and R stalled for required<br/>consecutive iterations?"}

    V -- Yes --> W["Reduce all nonlinear relaxation factors<br/>omega <- max(omegaMin, reductionFactor * omega)<br/>Typical: 0.5 -> 0.25 -> 0.125"]
    V -- No --> X{"Convergence mode?"}
    W --> X

    X -- "fixed" --> Y{"Reached nSolidificationLoops?"}
    Y -- No --> L
    Y -- Yes --> AA["Thermophysical substep accepted<br/>(legacy fixed-loop behavior)"]

    X -- "converged" --> Z{"k >= minIterations<br/>AND dT <= Ttol<br/>AND dC <= Ctol<br/>AND dfs <= fstol ?"}

    Z -- Yes --> AA
    Z -- No --> AB{"k == maxSolidificationIterations?"}
    AB -- No --> L
    AB -- Yes --> AC["Substep FAILED<br/>Do not accept its thermophysical state"]

    AA --> AD["Advance local thermophysical history only<br/>TsubOld <- T<br/>CsubOld <- Carbon<br/>fssubOld <- fs<br/>CpMixSubOld <- CpMix"]

    AD --> AE{"More thermophysical<br/>substeps in this attempt?"}
    AE -- Yes --> K
    AE -- No --> AF["Attempt accepted<br/>Nsub substeps exactly cover dtPhysical"]

    AC --> AG{"Can increase subcycling?<br/>thermophysicalSubcycling = true<br/>AND Nsub * factor <= maxNsub"}

    AG -- Yes --> AH["Restore complete thermophysical checkpoint<br/>Nsub <- Nsub * thermophysicalSubcycleFactor<br/>dtThermo <- dtPhysical / Nsub"]
    AH --> J

    AG -- No --> AI["Restore thermophysical checkpoint<br/>FatalError<br/>FAILED physical thermophysical state is never accepted"]

    AF --> AJ["pressureCorrector()<br/>PIMPLE pressure loop<br/>solve p, correct phi and U"]

    AJ --> AK["Momentum-transport corrector<br/>viscosity->correct()<br/>momentumTransport->correct()"]

    AK --> AL["postSolve()<br/>Refresh BKC drag and final diagnostics<br/>flow/Courant, species, phase, inventories,<br/>macrosegregation, requested diagnostics"]

    AL --> AM["Physical step accepted<br/>write/output as requested<br/>advance to next OpenFOAM time step"]

    AM --> A

    classDef fail fill:#fff,stroke:#333,stroke-width:2px;
    class AI fail;
